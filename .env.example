# ---------------------------------------------------------------------------
# Quick Bite core-service - environment template
# Copy to `.env` (git-ignored) and fill in real values:
#   cp .env.example .env
# Validated by zod in src/lib/config/env.ts - boot fails on missing required values.
# ---------------------------------------------------------------------------

# --- HTTP server ---
PORT=3000
NODE_ENV=development

# Allowed origins, comma-separated
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (PostGIS required) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=quickbite_core
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Knex migrations ---
DB_MIGRATION_DIRECTORY=src/migrations
DB_MIGRATION_EXTENSION=ts

# --- JWT (use long random secrets, never the placeholders) ---
ACCESS_SECRET=
REFRESH_SECRET=
ACCESS_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=604800

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=10

# --- Redis (caching + idempotency) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Mailjet (OTP and invitation emails) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Quick_Bite

# --- Internal service-to-service auth for /api/internal/* ---
# Empty means effectively unprotected - set a real secret in every deployed environment.
INTERNAL_API_KEY=

# --- RabbitMQ (outbox worker) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events

# --- Outbox worker ---
# 6-field cron expression; "* * * * * *" = every second
OUTBOX_DRAIN_CRON=* * * * * *
OUTBOX_BATCH_SIZE=50